# Free LLM Provider Configuration ('groq' or 'gemini')
LLM_PROVIDER=groq

# Groq API (Free tier: 30 RPM, near-instant inference)
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Free tier: 15 RPM, 1M TPM, 1,500 RPD)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google PageSpeed Insights API (Free tier: 25,000 requests/day, optional)
PAGESPEED_API_KEY=

# Crawler Configuration Defaults
MAX_PAGES_DEFAULT=25
CRAWLER_CONCURRENCY=5
REQUEST_DELAY_SECONDS=0.4
REQUEST_TIMEOUT_SECONDS=10.0
USER_AGENT=AuditPilotBot/0.1 (+https://cynbit.in/bot)
